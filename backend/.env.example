# HeritageGraph AI — backend local defaults
#
# `npm run setup` copies this file to backend/.env when that file does not
# exist yet. Only NON-SECRET values belong here; keep this file free of
# credentials so it can stay in version control. The full reference of every
# variable (including the provider examples) is the repository-root
# .env.example — this file only carries what a local start needs.
#
# Precedence: real process environment > backend/.env > backend/.vision_key >
# built-in development defaults (see backend/scripts/run_server.py).

# Required. SQLite is fine for local development; PostgreSQL for production.
DATABASE_URL=sqlite:///heritage.db

# Query Wikipedia's public API for real citable records (no key required) and
# use it for subject photographs / related-topic metadata. Without this the
# app answers from the local seeded store only.
HG_LIVE_SOURCES=1

# ---------------------------------------------------------------------------
# Vision provider — REQUIRED for real image analysis (turns the image into
# entities). Leave it commented out to run everything except analysis, or to
# use `npm run dev -- --demo` for the labelled fixture pipeline.
#
# Any OpenAI-compatible chat-completions endpoint works. Verified free-tier
# example (Google Gemini's compatibility endpoint):
#   VISION_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   VISION_MODEL=gemini-3.5-flash-lite
# Put the key in the shell, here, or (preferred locally) in
# backend/.vision_key, which is git-ignored:
#   echo "your-key" > backend/.vision_key
# ---------------------------------------------------------------------------
# VISION_API_BASE_URL=
# VISION_API_KEY=
# VISION_MODEL=

# OCR is OPTIONAL and separate from vision: when it is unset the run carries an
# explicit "OCR skipped" warning instead of inventing text, and an analysis
# without any extracted text is reported `partial` rather than `completed`.
#
# Google Cloud Vision (preferred). Needs ONE credential: a service-account JSON
# (GOOGLE_APPLICATION_CREDENTIALS, kept outside the repository), an API key, or a
# short-lived OAuth2 token. Never commit the JSON key.
# OCR_PROVIDER=google_vision
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_VISION_API_KEY=
# GOOGLE_CLOUD_PROJECT=
#
# Generic HTTP OCR: POST multipart to your endpoint. Set both or neither.
# OCR_PROVIDER=http
# OCR_API_URL=
# OCR_API_KEY=

# --------------------------------------------------------------- media -----
# Same-origin image proxy (serves subject photographs from this app's origin so
# image display cannot be broken by a browser's shields/DNS/proxy). On by
# default; set to `off` to load upstream image URLs directly.
# HG_MEDIA_PROXY=off
# Wikimedia's User-Agent policy requires a descriptive agent with a contact URL
# or email; its CDN answers 403 without one. The default uses APP_ORIGIN (or
# localhost) as the contact — set your own project URL or address here:
# HG_MEDIA_USER_AGENT=HeritageGraphAI/0.1 (+https://your-site.example; you@example.org)

# ----------------------------------------------------- archive studio -----
# Uploaded originals are preserved on disk (never in a database column); the
# default root is backend/var/archive and it is git-ignored. Point it at a
# mounted volume in deployment.
# HG_STORAGE_DIR=/var/lib/heritagegraph/archive
#
# ZIP safety limits (defaults shown). Unsafe members are always skipped.
# HG_ZIP_MAX_ENTRIES=60            # members inspected per ZIP
# HG_ZIP_MAX_ENTRY_BYTES=26214400  # 25 MB per extracted member
# HG_ZIP_MAX_TOTAL_BYTES=262144000 # 250 MB uncompressed output
# HG_ZIP_MAX_DEPTH=1               # 1 = no nested archives
#
# Archive OCR reuses the OCR provider above; with none configured, scanned
# documents are reported `partial` with their reason, never given fake text.

# -------------------------------------------------------------- accounts ---
# Email + password accounts work with no configuration: PBKDF2 hashes and
# opaque database sessions are built in. Optional tuning:
# SESSION_TTL_HOURS=168            # 7 days, clamped to 1 hour .. 30 days
# TRUST_PROXY_HEADERS=1            # ONLY behind a proxy that sets X-Forwarded-Proto
# CORS_ORIGINS=https://app.example.org   # only for a cross-origin frontend

# ------------------------------------------------------ stories & legends --
# Community oral histories are stored `pending` and are never public until an
# account on this allowlist approves them (comma or semicolon separated).
# Empty by default: submissions are collected for review, nothing is published.
# STORY_MODERATOR_EMAILS=curator@example.org

# ------------------------------------------------------------------ demo ---
# Labelled fixture pipeline for demos without credentials. Every run says DEMO
# MODE; refused outright when ENVIRONMENT=production. Never set for real work.
# HG_DEMO_MODE=1
